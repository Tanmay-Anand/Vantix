<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.vantix</groupId>
    <artifactId>vantix-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>vx-architecture-tests</artifactId>
  <name>Vantix :: Architecture Tests</name>
  <description>ArchUnit module-boundary tests that keep the thin-runtime / clean-seam guarantees
    from silently rotting: the toolchain must not leak into the runtime, and vx-core must stay
    framework-free.</description>

  <dependencies>
    <dependency>
      <groupId>dev.vantix</groupId>
      <artifactId>vx-core</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.vantix</groupId>
      <artifactId>vx-runtime</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.vantix</groupId>
      <artifactId>vx-codegen</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.vantix</groupId>
      <artifactId>vx-migrate</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.vantix</groupId>
      <artifactId>vx-cli</artifactId>
    </dependency>

    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
