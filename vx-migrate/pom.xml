<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.vantix</groupId>
    <artifactId>vantix-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>vx-migrate</artifactId>
  <name>Vantix :: Migrate</name>
  <description>Snapshot-diff migration engine: SchemaDiffer to typed SchemaChange list,
    PostgresRenderer to ordered Flyway DDL, and the information_schema introspector powering
    db pull, drift check, and the shadow-DB verify path (D13). No Spring.</description>

  <dependencies>
    <dependency>
      <groupId>dev.vantix</groupId>
      <artifactId>vx-core</artifactId>
    </dependency>

    <!-- SQL-renderer and introspection tests run against real PostgreSQL (14-17 in CI).
         Testcontainers 2.x renamed its modules to the testcontainers-* prefix; versions come
         from the testcontainers-bom the parent imports (pinned independently of Spring Boot). -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
